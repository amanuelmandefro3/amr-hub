generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Issue {
  id          String     @id
  sequence    Int        @unique
  title       String
  description String
  status      String     @default("OPEN")
  priority    String     @default("MEDIUM")
  kind        String     @default("TASK")
  assignee    String     @default("Unassigned")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  comments    Comment[]
  activity    Activity[]

  @@index([createdAt])
  @@index([status])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  author    String
  createdAt DateTime @default(now())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
}

model Activity {
  id          String   @id @default(cuid())
  type        String
  description String
  actor       String
  createdAt   DateTime @default(now())
  issueId     String
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
}
