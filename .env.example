# Pooled connection used by the running application.
DATABASE_URL="postgresql://amr_hub:amr_hub_local@localhost:55433/amr_hub?schema=public"

# Direct connection used by Prisma migrations and administrative commands.
DIRECT_URL="postgresql://amr_hub:amr_hub_local@localhost:55433/amr_hub?schema=public"

# Canonical public origin. Used for trusted origins, invitation links, and
# verification/reset emails. Required in production - startup fails without it.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Generate the production value with `openssl rand -base64 32`.
BETTER_AUTH_SECRET="change-me-with-openssl-rand-base64-32"
